generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ZoneOnboardingQueueState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ZoneOnboardingQueue {
  id                String                   @id @default(uuid())
  postalCode        String
  requestedDay      DateTime
  state             ZoneOnboardingQueueState @default(PENDING)
  attempts          Int                      @default(0)
  requestedByUserId String?
  errorMessage      String?
  processedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([postalCode, requestedDay])
  @@index([state, requestedDay])
  @@index([postalCode])
}

model Product {
  id          String         @id @default(uuid())
  name        String
  supermarket String
  category    String
  sku         String
  unit        String
  image       String?
  url         String?
  taxType     String
  prices      ProductPrice[]

  @@unique([supermarket, sku])
  @@index([name])
  @@index([category])
  @@index([supermarket])
}

model PricingZone {
  id          String       @id
  name        String
  prices      ProductPrice[]
  postalCodes PostalCode[]

  @@index([name])
}

model PostalCode {
  code   String      @id
  zoneId String
  zone   PricingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([zoneId])
}

model ProductPrice {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         PricingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  price        Float
  pricePerUnit Float
  scrapedAt    DateTime    @default(now())

  @@unique([productId, zoneId])
  @@index([zoneId])
  @@index([productId])
}

model ShoppingSession {
  id         String                @id @default(uuid())
  userId     String
  shoppedAt  DateTime
  totalPrice Float
  createdAt  DateTime              @default(now())
  items      ShoppingSessionItem[]

  @@index([userId])
  @@index([shoppedAt])
}

model ShoppingSessionItem {
  id           String          @id @default(uuid())
  sessionId    String
  session      ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productName  String
  supermarket  String
  category     String
  price        Float
  pricePerUnit Float
  unit         String
  taxType      String
  quantity     Int
  image        String?
  url          String?

  @@index([sessionId])
}

model ActiveCart {
  id        String           @id @default(uuid())
  userId    String           @unique
  updatedAt DateTime         @updatedAt
  items     ActiveCartItem[]

  @@index([userId])
}

model ActiveCartItem {
  id           String     @id @default(uuid())
  cartId       String
  cart         ActiveCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  supermarket  String
  category     String
  price        Float
  pricePerUnit Float
  unit         String
  taxType      String
  quantity     Int
  image        String?
  url          String?

  @@unique([cartId, supermarket, productName])
  @@index([cartId])
}

model ProductCategoryCache {
  id             String   @id @default(uuid())
  normalizedName String   @unique
  category       String
  createdAt      DateTime @default(now())

  @@index([normalizedName])
}
