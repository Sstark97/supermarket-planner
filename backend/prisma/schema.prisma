generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  supermarket  String
  category     String
  sku          String
  price        Float
  pricePerUnit Float
  unit         String
  image        String?
  url          String?
  taxType      String
  scrapedAt    DateTime @default(now())

  @@unique([supermarket, sku])
  @@index([name])
  @@index([category])
  @@index([supermarket])
}

model ShoppingSession {
  id         String                @id @default(uuid())
  userId     String
  shoppedAt  DateTime
  totalPrice Float
  createdAt  DateTime              @default(now())
  items      ShoppingSessionItem[]

  @@index([userId])
  @@index([shoppedAt])
}

model ShoppingSessionItem {
  id           String          @id @default(uuid())
  sessionId    String
  session      ShoppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productName  String
  supermarket  String
  category     String
  price        Float
  pricePerUnit Float
  unit         String
  taxType      String
  quantity     Int
  image        String?
  url          String?

  @@index([sessionId])
}

model ActiveCart {
  id        String           @id @default(uuid())
  userId    String           @unique
  updatedAt DateTime         @updatedAt
  items     ActiveCartItem[]

  @@index([userId])
}

model ActiveCartItem {
  id           String     @id @default(uuid())
  cartId       String
  cart         ActiveCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  supermarket  String
  category     String
  price        Float
  pricePerUnit Float
  unit         String
  taxType      String
  quantity     Int
  image        String?
  url          String?

  @@unique([cartId, supermarket, productName])
  @@index([cartId])
}
